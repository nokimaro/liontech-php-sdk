{
    "name": "nokimaro/liontech-php-sdk",
    "description": "Community-maintained PHP SDK for LionTech Payment Gateway",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "liontech",
        "payment",
        "payment-gateway",
        "sdk",
        "api",
        "php"
    ],
    "homepage": "https://github.com/nokimaro/liontech-php-sdk",
    "support": {
        "issues": "https://github.com/nokimaro/liontech-php-sdk/issues",
        "source": "https://github.com/nokimaro/liontech-php-sdk"
    },
    "require": {
        "php": "^8.3",
        "php-http/discovery": "^1.19",
        "php-http/multipart-stream-builder": "^1.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-type-coverage": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "psr/log": "^3.0",
        "rector/rector": "^2.0",
        "symplify/easy-coding-standard": "^12.3"
    },
    "suggest": {
        "guzzlehttp/guzzle": "To use the Guzzle HTTP client (recommended)",
        "psr/log": "To enable logging capabilities"
    },
    "autoload": {
        "psr-4": {
            "LionTech\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LionTech\\SDK\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest --compact",
        "test-coverage": "XDEBUG_MODE=\"coverage\" vendor/bin/pest --coverage --min=95",
        "test-type-coverage": "vendor/bin/pest --type-coverage --min=100",
        "test-mutation": "XDEBUG_MODE=\"coverage\" vendor/bin/pest --mutate --parallel --everything --covered-only --min=80 --compact",
        "phpstan": "phpstan analyse",
        "ecs": "ecs check",
        "ecs:fix": "ecs check --fix",
        "rector": "rector process",
        "rector:dry-run": "rector process --dry-run",
        "check": [
            "@ecs",
            "@phpstan",
            "@test"
        ],
        "fix": [
            "@ecs:fix",
            "@rector"
        ]
    },
    "authors": [
        {
            "name": "Nik Dm",
            "email": "nox@nox.kz",
            "role": "Maintainer"
        }
    ]
}
